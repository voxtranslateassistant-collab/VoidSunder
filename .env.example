# --- Painel Vercel: apenas valores públicos do Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Crie um valor aleatório de 32 bytes. Nunca use prefixo NEXT_PUBLIC_.
LLM_KEY_ENCRYPTION_SECRET=

# Chave separada para as credenciais de teste dos ativos autenticados.
# Gere 32 bytes aleatórios, use o mesmo valor no Vercel e no Railway.
ASSET_CREDENTIAL_ENCRYPTION_SECRET=

# --- LLM Lab: chaves gratuitas (adicione as que tiver) ---
# Google Gemini  -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Groq           -> https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter     -> https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
